# ==============================================================================
# IPRED Chatbot UIS - Variables de Entorno de Configuración
# ==============================================================================

# --- Puertos de Servicios ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
SEARXNG_PORT=8080

# --- Base de Datos PostgreSQL ---
POSTGRES_USER=ipred_user
POSTGRES_PASSWORD=ipred_secure_password_2026!
POSTGRES_DB=ipred_chatbot

# --- Caché Redis ---
REDIS_PASSWORD=ipred_redis_pass_2026!

# --- Inteligencia Artificial Google Gemini ---
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Seguridad y Autenticación JWT ---
JWT_SECRET=generar_clave_secreta_de_32_caracteres_minimo_aqui
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# --- Configuración General ---
APP_NAME="IPRED Chatbot UIS"
APP_DEBUG=false
TZ=America/Bogota
